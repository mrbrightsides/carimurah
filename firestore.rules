rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Low-level helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Schema validation helpers
    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() <= 128
          && (data.displayName == null || (data.displayName is string && data.displayName.size() <= 100))
          && (data.email == null || (data.email is string && data.email.size() <= 100))
          && (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 500))
          && (data.preferences == null || data.preferences is map);
    }
    
    function isValidHistoryItem(data) {
      return data.date is string && data.date.size() <= 50
          && data.totalSaved is number
          && data.itemsCount is number
          && data.type in ['B2C', 'B2B']
          && data.result is map;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) 
                     && incoming().uid == userId; // Immutable UID
      
      match /history/{historyId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidHistoryItem(incoming());
        allow delete: if isOwner(userId);
        // History is immutable in our app, so no update allowed unless owner
      }
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
