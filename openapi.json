{
  "openapi": "3.0.0",
  "info": {
    "title": "CariMurah.ai API",
    "description": "API for CariMurah.ai - Indonesian Shopping Agent with MongoDB storage",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://carimurah-ai-875241790017.europe-west1.run.app",
      "description": "Production Server (Cloud Run)"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Check API health",
        "operationId": "checkHealth",
        "responses": {
          "200": {
            "description": "Server is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/process": {
      "post": {
        "summary": "Run agentic shopping analysis",
        "operationId": "processAnalysis",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": { "type": "string", "description": "User query or prompt" },
                  "image": { "type": "string", "description": "Base64 image string of receipt/invoice" },
                  "isB2B": { "type": "boolean", "description": "Flag for procurement features" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Analysis result successfully generated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "message": { "type": "string", "description": "The final response message from CariMurah engine" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/profile/{uid}": {
      "get": {
        "summary": "Get user profile",
        "operationId": "getUserProfile",
        "parameters": [
          {
            "name": "uid",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "User profile data",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserProfile" }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Update user profile",
        "operationId": "updateUserProfile",
        "parameters": [
          {
            "name": "uid",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserProfile" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/history": {
      "get": {
        "summary": "Get user shopping history",
        "operationId": "getHistory",
        "parameters": [
          {
            "name": "uid",
            "in": "query",
            "description": "The user ID. If not provided, returns a sample/generic history for testing.",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of history items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/HistoryItem" }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UserProfile": {
        "type": "object",
        "properties": {
          "uid": { "type": "string" },
          "displayName": { "type": "string" },
          "email": { "type": "string" },
          "b2bFocus": { "type": "string", "enum": ["price", "delivery", "rating"] },
          "subscription": {
            "type": "object",
            "properties": {
              "tier": { "type": "string", "enum": ["FREE", "PRO", "ENTERPRISE"] }
          }
        }
      }
    },
      "HistoryItem": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "userId": { "type": "string" },
          "date": { "type": "string" },
          "itemsCount": { "type": "integer" },
          "totalSaved": { "type": "number" },
          "type": { "type": "string", "enum": ["B2C", "B2B"] }
        }
      }
    }
  }
}