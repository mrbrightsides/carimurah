{
  "openapi": "3.0.0",
  "info": {
    "title": "CariMurah.ai API",
    "description": "API for CariMurah.ai - Indonesian Shopping Agent with MongoDB storage",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://ais-pre-7xkvumwn2pakj7laysavzs-111006670209.asia-southeast1.run.app",
      "description": "Shared App Server (AIS Preview)"
    },
    {
      "url": "https://carimurah-ai-875241790017.europe-west1.run.app",
      "description": "Production Server (Cloud Run)"
    },
    {
      "url": "https://ais-dev-7xkvumwn2pakj7laysavzs-111006670209.asia-southeast1.run.app",
      "description": "Development Server (AIS)"
    }
  ],
  "paths": {
    "/api/profile/{uid}": {
      "get": {
        "summary": "Get user profile",
        "operationId": "getUserProfile",
        "parameters": [
          {
            "name": "uid",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "User profile data",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserProfile" }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Update user profile",
        "operationId": "updateUserProfile",
        "parameters": [
          {
            "name": "uid",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserProfile" }
            }
          }
        },
        "responses": {
          "200": { "description": "Success" }
        }
      }
    },
    "/api/history": {
      "get": {
        "summary": "Get generic or global shopping history",
        "description": "Returns a list of recent shopping analysis items. useful for getting trends or samples.",
        "operationId": "getGlobalHistory",
        "parameters": [
          {
            "name": "uid",
            "in": "query",
            "description": "Optional user ID to filter history",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of history items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/HistoryItem" }
                }
              }
            }
          }
        }
      }
    },
    "/api/history/{uid}": {
      "get": {
        "summary": "Get specific user shopping history",
        "description": "Returns all saved items for a specific User ID from MongoDB.",
        "operationId": "getUserHistory",
        "parameters": [
          {
            "name": "uid",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "User history data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/HistoryItem" }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Save item to user history",
        "description": "Adds a new analyzed product item to the user's MongoDB history collection.",
        "operationId": "saveToHistory",
        "parameters": [
          {
            "name": "uid",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/HistoryItemCreate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "id": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    },
    "/api/history/{uid}/{historyId}": {
      "patch": {
        "summary": "Update a history item",
        "description": "Modify details of a specific saved history item in MongoDB.",
        "operationId": "updateHistoryItem",
        "parameters": [
          {
            "name": "uid",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "historyId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "type": "object" }
            }
          }
        },
        "responses": {
          "200": { "description": "Success" }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Check API health",
        "operationId": "checkHealth",
        "responses": {
          "200": {
            "description": "Server is healthy",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "status": { "type": "string" } } }
              }
            }
          }
        }
      }
    },
    "/api/process": {
      "post": {
        "summary": "Run agentic shopping analysis",
        "operationId": "processAnalysis",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": { "type": "string" },
                  "image": { "type": "string", "description": "Base64 image string" },
                  "isB2B": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Analysis result" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UserProfile": {
        "type": "object",
        "properties": {
          "uid": { "type": "string" },
          "displayName": { "type": "string" },
          "email": { "type": "string" },
          "b2bFocus": { "type": "string", "enum": ["price", "delivery", "rating"] },
          "subscription": {
            "type": "object",
            "properties": {
              "tier": { "type": "string", "enum": ["FREE", "PRO", "ENTERPRISE"] }
            }
          }
        }
      },
      "HistoryItem": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "userId": { "type": "string" },
          "date": { "type": "string" },
          "itemsCount": { "type": "integer" },
          "totalSaved": { "type": "number" },
          "type": { "type": "string", "enum": ["B2C", "B2B"] },
          "productName": { "type": "string" },
          "brand": { "type": "string" },
          "recommendedPrice": { "type": "number" },
          "platform": { "type": "string" }
        }
      },
      "HistoryItemCreate": {
        "type": "object",
        "required": ["productName", "brand", "recommendedPrice", "platform"],
        "properties": {
          "productName": { "type": "string" },
          "brand": { "type": "string" },
          "recommendedPrice": { "type": "number" },
          "platform": { "type": "string" },
          "totalSaved": { "type": "number" },
          "type": { "type": "string", "default": "B2C" }
        }
      }
    }
  }
}
